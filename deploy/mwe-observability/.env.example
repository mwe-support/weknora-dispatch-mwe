MONITORED_HOST=marvel-kb
GRAFANA_BIND_ADDRESS=192.168.18.25
GRAFANA_PORT=13000
GRAFANA_ROOT_URL=http://192.168.18.25:13000
PROMETHEUS_PORT=19090
LOKI_PORT=13100
ALLOY_PORT=12345

# Pin every image; update deliberately after reading the upstream release notes.
GRAFANA_IMAGE=grafana/grafana:13.1.0
PROMETHEUS_IMAGE=prom/prometheus:v3.11.3
LOKI_IMAGE=grafana/loki:3.7.0
ALLOY_IMAGE=grafana/alloy:v1.18.0

# Initial single-host deployment. For a remote backend, point these two URLs at
# the protected Prometheus remote-write and Loki push endpoints instead.
PROMETHEUS_REMOTE_WRITE_URL=http://prometheus:9090/api/v1/write
LOKI_WRITE_URL=http://loki:3100/loki/api/v1/push

# Existing production Docker networks. Verify with `docker network ls` first.
WEKNORA_NETWORK_NAME=src_WeKnora-network
KB_BACKPLANE_NETWORK_NAME=kb-backplane

# Read-only observability role created by scripts/install.sh.
WEKNORA_DB_HOST=WeKnora-postgres
WEKNORA_DB_PORT=5432
WEKNORA_DB_NAME=weknora
WEKNORA_DB_USER=weknora_observer
WEKNORA_DB_PASSWORD=replace-me

WEKNORA_REDIS_HOST=WeKnora-redis
WEKNORA_REDIS_PORT=6379
WEKNORA_REDIS_PASSWORD=replace-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me

# Capability and recent-log probes. Comma-separated container names only.
EXPECTED_CONTAINERS=WeKnora-postgres,WeKnora-redis,WeKnora-minio,WeKnora-docreader,WeKnora-app,WeKnora-frontend,kb-qdrant,kb-q4-gpu0,kb-q4-gpu1,kb-q4-router,kb-embed-text,kb-rerank-text,kb-mineru-api,WeKnora-mcp
MINERU_CONTAINER=kb-mineru-api
MINERU_PYTHON=python3
GPU_SOURCES=0:kb-q4-gpu0,1:kb-q4-gpu1
PROBE_INTERVAL_SECONDS=30
LOG_WINDOW_SECONDS=120
